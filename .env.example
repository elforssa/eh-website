NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SITE_URL=
SESSION_SECRET=

# Website -> CRM inquiry adapter. Server-side only.
CRM_INQUIRY_ENDPOINT=https://admin.english-hills.com/api/public/crm-inquiry
CRM_WEBSITE_SITE_KEY=english-hills-website
# Random secret, at least 32 characters; signs a short-lived, non-PII success receipt.
CRM_WEBSITE_RECEIPT_SECRET=

NEXT_PUBLIC_SUPABASE_ANON_KEY=

SUPABASE_SERVICE_ROLE_KEY=

# Shared Meta tracking
NEXT_PUBLIC_META_PIXEL_ID=
META_CAPI_ACCESS_TOKEN=
META_GRAPH_API_VERSION=v23.0

# Recruitment application security and durable delivery
JOB_APPLICATION_FORM_SECRET=
CRON_SECRET=

# Recruitment Google Sheet (service account credentials stay server-side)
GOOGLE_SHEETS_CLIENT_EMAIL=
GOOGLE_SHEETS_PRIVATE_KEY=
GOOGLE_SHEETS_RECRUITMENT_SPREADSHEET_ID=
GOOGLE_SHEETS_RECRUITMENT_RANGE=Applications!A:AC
# Optional, only for future temporary hiring landing pages. Use a separate Sheet
# whose A:G columns are request UUID, timestamp, role, name, phone, email, answers.
GOOGLE_SHEETS_TEMP_HIRING_SPREADSHEET_ID=
GOOGLE_SHEETS_TEMP_HIRING_SHEET=

# Optional: only set while validating recruitment CAPI in Meta Test Events
META_RECRUITMENT_TEST_EVENT_CODE=

GOOGLE_REVIEW_URL=

# Destination for the /contact-camp enrollment-CTA redirect (e.g. a WhatsApp link)
WHATSAPP_CTA_URL=

# /souvenirs — camp photo gallery (server-side only, never expose with NEXT_PUBLIC_)
CAMP_ACCESS_CODE=
CAMP_COOKIE_SECRET=
# JSON array of weekly sessions, rendered in order. videoId is optional.
CAMP_SESSIONS=[{"prefix":"2026-juillet-s1/","label":"Semaine 1 · 6–10 juillet","videoId":""},{"prefix":"2026-juillet-s2/","label":"Semaine 2 · 13–17 juillet"}]
